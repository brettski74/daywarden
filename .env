# The first of a block of 10 ports on this machine. The proxy that clients
# use is PORT_BASE, the policy pages are PORT_BASE+4, and the proxy
# auto-configuration file is PORT_BASE+8. 8080 when it is left out.
PORT_BASE=8080

# Any of the three can be set on its own instead, and wins over PORT_BASE:
# PROXY_PORT=8080
# POLICY_PORT=8084
# PROXY_CONFIG_PORT=8088
# The policy pages are HTTPS, signed by the CA below. POLICY_PORT is the
# published port, not the port the decisions container binds.

# DNS names and IP addresses the parent uses to open those pages.
# Comma-separated. An empty list stops the decisions service. The certificate
# is not taken from the Host header of a request.
# These are also the policy server's names that the proxy forwards without a
# decision, with the child's address, so the task pages open at any time.
# localhost, 127.0.0.1, and ::1 are left out of that. The proxy reads this
# list only on dw restart, while config/bypass.txt is read on every request,
# so list the same names in bypass.txt as well. dw check warns when one is
# missing there. The proxy auto-configuration file sends them direct.
PARENT_NAMES=garden,garden.bakuna.net,localhost,127.0.0.1

# Directory that keeps the CA key and certificate across container restarts.
# If you change it, create the directory first and own it, so you can read the
# certificate afterwards. The file to copy out is mitmproxy-ca-cert.pem.
CA_VOLUME_PATH=./data/ca

# Directory on this machine for files the parent manages, such as spelling
# recordings in spelling/current and spelling/revision. It is mounted
# read-only into the decisions container at /var/lib/daywarden/data.
DAYWARDEN_DATA_DIR=${HOME}/daywarden
