# Clients use this port on the machine running Docker Compose. Edit it here only.
PROXY_PORT=8080

# Port on this machine for the parent pages. They are HTTPS, signed by the CA below.
REPORT_PORT=8090

# DNS names and IP addresses the parent uses to open those pages.
# Comma-separated. An empty list stops the decisions service. The certificate
# is not taken from the Host header of a request.
PARENT_NAMES=localhost,127.0.0.1

# Directory that keeps the CA key and certificate across container restarts.
# If you change it, create the directory first and own it, so you can read the
# certificate afterwards. The file to copy out is mitmproxy-ca-cert.pem.
CA_VOLUME_PATH=./data/ca
